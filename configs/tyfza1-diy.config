#
# TYFZA1 · 自定义配置（由 diy-part.sh 复制到 sources/openwrt/.config）
#
# 用法：workflow 的 config_file 输入留空，让 diy-part.sh 写 .config；
#       或者填 configs/tyfza1-diy.config，效果一样（二选一，别两处都填）。
#
# 三条硬约束，改之前先记住：
#   1) rootfs.squashfs 上限 33648640 字节（约 32.09 MiB，原厂 UBI 卷），超了打包直接失败；
#   2) 内核模块事后补不了（kmod 带内核 vermagic 哈希），要留的现在就得编进去；
#   3) 源码树里没有的包，make defconfig 会静默丢行，不报错。
#
# 上游是官方 OpenWrt（feeds 只有 packages + luci），不是 ImmortalWrt，
# 所以 xg-040g-md.config 里 default-settings-chn / autocore / automount /
# luci-app-cpufreq / luci-app-ddns-go / luci-app-passwall / argon 主题
# 这一批在官方 feeds 里根本不存在，下面已经全部剔除，别照搬过来。
#

#
# Target —— 与 port/configs/tyfza1-boot.config 保持一致，一个字都别改
#
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_SIGNED_PACKAGES is not set
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
CONFIG_IMAGEOPT=y

#
# 本机必需（DEVICE_PACKAGES 会自动带上，这里显式写一份防丢）
#
CONFIG_PACKAGE_luci-app-tyfza1-pon=y          # PON 管理页，本项目的核心
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_kmod-rtl-ax-ap=y               # Realtek 无线驱动
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y

#
# 基础系统
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump-mini=y                 # 比 tcpdump 小一半，够排障用
CONFIG_PACKAGE_iperf3=y

#
# DNS —— dnsmasq-full（OpenClash 硬依赖），由 diy-part.sh 强制改写，这里写也行
#
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y          # firewall4 走 nftset，会带 nftables-json

#
# 代理相关的内核模块 —— 特意保留，整组约 40 KB
#
# kmod 硬绑带哈希的内核版本，官方源那份对不上自建固件，刷完机 apk add 装不上。
# 留着才能走通"刷完机再装代理软件"这条路；sing-box / clash 的 tun、tproxy、
# ss 也全靠这几块。
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nft-tproxy=y              # 透明代理：passwall / openclash / homeproxy
CONFIG_PACKAGE_kmod-nft-socket=y              # nft socket 匹配（会带 kmod-nf-socket）
CONFIG_PACKAGE_kmod-nf-socket=y               # nf_socket 查找
CONFIG_PACKAGE_kmod-tun=y                     # TUN 设备：tun 模式 / fake-ip
CONFIG_PACKAGE_kmod-inet-diag=y               # ss / 连接诊断，sing-box 硬依赖
CONFIG_PACKAGE_kmod-netlink-diag=y            # netlink 诊断，sing-box 硬依赖
CONFIG_PACKAGE_kmod-tcp-bbr=y                 # turboacc 的 BBR 会带，这里写死一份

#
# SmartDNS（源码由 diy-part.sh 换成 papatuoni/smartdns@custom-48.4）
#
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

#
# OpenClash（源码由 diy-part.sh 从 vernesong/OpenClash 装载）
#
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_ruby=y                         # 体积大头：约 5 MB 级，超容量先砍它
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_luci-compat=y                  # 官方 luci feed 在 modules/ 下；OpenClash 与 turboacc 都要

#
# TurboACC（源码由 diy-part.sh 用 add_turboacc.sh --no-sfe 装载）
#
# 符号名是 chenmozhijin 的 luci-app-turboacc_INCLUDE_*，
# 与 ImmortalWrt 的 CONFIG_PACKAGE_TURBOACC_INCLUDE_* 不是一回事，别混用。
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV is not set

#
# 语言
#
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

#
# 可选（体积还有余量再开，逐个加，别一次全上）
#
CONFIG_PACKAGE_luci-app-package-manager=y     # apk 的包管理界面，替代 luci-app-opkg
CONFIG_PACKAGE_luci-app-ttyd=y                # 网页终端
CONFIG_PACKAGE_luci-app-nlbwmon=y           # 流量统计
CONFIG_PACKAGE_luci-app-upnp=y              # UPnP
# CONFIG_PACKAGE_luci-app-sqm=m               # 智能队列，要连带 sqm-scripts
# CONFIG_PACKAGE_sqm-scripts=m
# CONFIG_PACKAGE_luci-app-watchcat=m          # 断网自动重连/重启
# CONFIG_PACKAGE_luci-app-adblock-fast=m      # 去广告（比 adguardhome 小一个数量级）
# CONFIG_PACKAGE_luci-app-samba4=y            # 文件共享，体积不小
# CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

#
# 明确不装 —— 体积的绝对大头，32 MiB 里塞不下
#
#   luci-app-passwall + xray-core(10.4M) + sing-box(14.3M) + geoview
#   luci-app-adguardhome(10.9M)
#   luci-app-mwan3（mwan3 在 routing feed 里，本项目 feeds.conf 没挂）
#
# 真想要：这些都是纯用户态包，刷完机 apk add 能装，但前提是本配置里
# 那几个内核模块已经编进去了 —— 这也是上面那组 kmod 必须留的原因。
