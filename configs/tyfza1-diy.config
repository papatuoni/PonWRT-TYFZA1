#
# TYFZA1 · 自定义配置（由 diy-part.sh 复制到 sources/openwrt/.config）
#
# 用法：workflow 的 config_file 输入留空，让 diy-part.sh 写 .config。
#       （一旦填了 config_file，build.sh → sync-overlay.sh 会用 TYFZA1_CONFIG
#        覆盖整个 .config，diy 的改动全部作废。）
#
# 本文件只放【顶层选择】：target、应用、语言、可选组件。
# 依赖级的包一律交给 diy-part.sh 的 force_pkg 写入，避免两处重复。
#
# 以下两类行【不要写在本文件】，写了也会被覆盖或强制：
#
#   a) port/configs/tyfza1-compat.config 里的 CONFIG_PACKAGE_*=y
#      由 sync-overlay.sh 先删后写、强制 =y（改不动），且 build.sh 会校验
#      「必须存在于 .config」，缺一条就 exit 1。包含：
#        openwrt-keyring ca-bundle libatomic libstdcpp libpthread librt
#        kmod-tun kmod-wireguard kmod-ovpn-backports
#        kmod-ifb kmod-sched-core kmod-sched-cake kmod-sched-connmark
#        kmod-sched-ctinfo kmod-nf-conntrack-netlink kmod-inet-diag
#        iptables-nft ip6tables-nft iptables-mod-conntrack-extra
#        iptables-mod-ipopt iptables-mod-tproxy iptables-mod-socket
#        ip6tables-mod-nat
#        kmod-nft-socket kmod-nft-tproxy kmod-nft-compat kmod-nft-queue
#        kmod-ipt-ipset kmod-ipt-ipopt kmod-ipt-conntrack
#        kmod-ipt-conntrack-extra kmod-ipt-tproxy kmod-ipt-nat
#        kmod-ip6tables kmod-ipt-nat6
#
#   b) luci-theme-argon / luci-i18n-argon-config-zh-cn / CONFIG_LUCI_LANG_zh_Hans
#      由 prepare_luci_feeds.sh 强制追加；argon 本体是上游从
#      port/sources.lock.json 锁定的 jerrykuku commit 装进 feeds/luci-theme-argon
#      （该仓库的 compat/ 目录里还自带 luci-app-argon-config）。
#      ⚠ 千万别自己 git clone argon 到 package/luci-theme-argon：
#        prepare_luci_feeds.sh 检测到「已存在且不是软链接」会直接 exit 1。
#
# 三条硬约束：
#   1) rootfs.squashfs 上限 33648640 字节（约 32.09 MiB），超了打包直接失败；
#   2) kmod 带内核 vermagic 哈希，刷完机 apk add 装不上，要留的现在编进去；
#   3) 源码树里没有的包，make defconfig 会静默丢行、不报错。
#


#
# Target —— 与 port/configs/tyfza1-boot.config 保持一致，一个字都别改
#
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
CONFIG_IMAGEOPT=y
# CONFIG_SIGNED_PACKAGES / CONFIG_VERSIONOPT 由 sync-overlay.sh 强制改写，不用管


#
# 应用 —— 只列顶层 app，依赖由 diy-part.sh 补齐
#
CONFIG_PACKAGE_luci-app-tyfza1-pon=y          # PON 管理页，本项目核心
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# DNS：dnsmasq-full 由 diy-part.sh 2a 强制（含 nftset + dnssec），此处不再写
# 代理相关 kmod：由 diy-part.sh 2b 强制，此处不再写
# OpenClash 的依赖（ruby / ruby-yaml / bash / curl / unzip / ip-full /
# luci-compat）：由 diy-part.sh 第 4 步强制，此处不再写
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# TurboACC —— 只写 app；INCLUDE_* 三个开关由 diy-part.sh 第 5 步写入
# （BBR_CCA 会自动带 kmod-tcp-bbr，所以也不用单独写 kmod-tcp-bbr）
CONFIG_PACKAGE_luci-app-turboacc=y

# SmartDNS —— 源码由 diy-part.sh 换成 papatuoni/smartdns@custom-48.4，
#              LuCI 界面与中文翻译换成 ImmortalWrt 1.2025.47.2（含「备用服务器」）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# 动态域名 —— ddns-go + luci-app-ddns-go 均取自 ImmortalWrt，
#             本体与界面由 diy-part.sh 第 7 步装载，此处不再写（写了也装不到，
#             因为 prepare_luci_feeds.sh 只认 .config 里已有的包）


#
# 基础系统
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_tcpdump-mini=y                 # 比 tcpdump 小一半，够排障
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y                 # 查速率/双工/自动协商（2.5G 口排查用）
                                              # 注意与 ethtool 互斥（CONFLICTS），只留一个


#
# 无线 —— 全部关闭（用户要求）
#
# 原来这里有 5 项，现全部移除：
#   kmod-rtl-ax-ap   本机 RTL8852C/RTL8192XB AP 驱动（cfg80211+mac80211+rtl_ax_ap.ko）
#   wpad-mbedtls     hostapd / wpa_supplicant
#   wifi-scripts     无线配置脚本
#   wireless-regdb   监管数据库
#   iw               无线调试工具
# 注意：前四项还写在上游 port/overlay/.../rtl9617c/image/Makefile 的
#       DEVICE_PACKAGES 里，光改 .config 没用——diy-part.sh 第 2-2 步会
#       直接从 overlay 源里把它们摘掉（sync-overlay.sh 是
#       rsync --delete，改源码树的副本会被冲掉）。
# 想恢复：把 DIY_WIRELESS 设成 1 重新编译即可。
#
# 内核侧（config-6.18 的 CFG80211/MAC80211/RTL_AX_AP=m）保持不动：
#   模块仍编出来，但没人打包进 rootfs，不影响体积，也避免了动内核配置的风险。


#
# 语言
#
CONFIG_LUCI_LANG_zh_Hans=y                    # prepare_luci_feeds.sh 也会强制
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y


#
# 可选（体积还有余量再开，逐个加，别一次全上）
#
CONFIG_PACKAGE_luci-app-package-manager=y     # apk 的包管理界面，替代 luci-app-opkg
CONFIG_PACKAGE_luci-app-ttyd=y                # 网页终端
# CONFIG_PACKAGE_luci-app-nlbwmon=y           # 流量统计
# CONFIG_PACKAGE_luci-app-upnp=y              # UPnP
# CONFIG_PACKAGE_luci-app-watchcat=m          # 断网自动重连/重启
# CONFIG_PACKAGE_luci-app-adblock-fast=m      # 去广告
# CONFIG_PACKAGE_luci-app-samba4=y            # 文件共享，体积不小
# CONFIG_PACKAGE_luci-app-sqm=m               # 智能队列，要连带 sqm-scripts
# CONFIG_PACKAGE_sqm-scripts=m


#
# 明确不装 —— 体积的绝对大头，32 MiB 里塞不下
#
#   luci-app-passwall + xray-core(10.4M) + sing-box(14.3M) + geoview
#   luci-app-adguardhome(10.9M)
#   luci-app-mwan3（mwan3 在 routing feed 里，本项目 feeds.conf 没挂）
#
# 这些都是纯用户态包，刷完机 apk add 能装，前提是 diy-part.sh 2b 那组
# kmod 已经编进镜像。
